# Supabase Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用（絶対にNEXT_PUBLIC_を付けない、ブラウザに公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# /shino LPのCTAボタンの遷移先（LINE公式アカウントの友だち追加URL・相談用URLなど）
NEXT_PUBLIC_LINE_URL=

# 本番公開URL（OGP画像等の絶対URL解決に使用。例: https://shino-crm.example.com）
NEXT_PUBLIC_SITE_URL=
